@page
@model IndexModel
@{
    ViewData["Title"] = "Analizador léxico";
}

<section class="hero">
    <div>
        <span class="eyebrow">Lenguaje OLLIN</span>
        <h1>Analizador léxico</h1>
        <p>Separa un programa en tokens, ejecuta cada lexema en el AFND y genera el archivo de tokens, la tabla de símbolos y los errores léxicos.</p>
    </div>
    <div class="database-status" aria-label="Estado de la base de datos">
        <span class="status-dot"></span>
        <div><strong>Base conectada</strong><small>@Model.Proveedor · @Model.TotalEstados estados · @Model.TotalTransiciones transiciones</small></div>
    </div>
</section>

<section class="validator-card">
    <div class="instructions">
        <h2>Escribe un programa</h2>
        <p>Puedes introducir varios tokens, separados por espacios, operadores o saltos de línea. Un error no detiene el análisis de los tokens siguientes.</p>
        <p class="rule"><strong>Identificador:</strong> comienza con una letra o <code>_</code>, continúa con letras, dígitos o guiones bajos y termina con letra o guion bajo. Una sola letra o <code>_</code> también es válida.</p>
    </div>
    <form method="post" id="validator-form" class="validator-form">
        <label asp-for="Cadena">Programa fuente</label>
        <div class="source-editor-wrap">
            <textarea asp-for="Cadena" id="cadena" rows="5" autocomplete="off" spellcheck="false" placeholder="Ejemplo: START = VARIABLE&#10;AND _DANY2_" autofocus></textarea>
        </div>
        <input type="file" id="program-file" accept=".txt,text/plain" hidden />
        <div class="source-actions">
            <button type="button" id="load-program" class="secondary-action">Cargar programa</button>
            <button type="button" id="edit-program" class="secondary-action">Editar programa</button>
            <button type="submit" class="primary-action">Verificar programa</button>
            <span id="program-status" class="program-status" aria-live="polite">
                @(Model.Resultado is null ? "Escribe o carga un archivo .txt" : Model.Resultado.Valido ? "Programa verificado: listo para guardar" : "Corrige los errores antes de guardar")
            </span>
        </div>
    </form>
    <div class="examples" aria-label="Ejemplos rápidos">
        <span>Probar:</span>
        @foreach (var example in new[] { "START = VARIABLE", "VAR >= VARIABLE", "AND NOT OR", "VAR_1_A_ = START", "VARIABLE = 10" })
        {
            <button type="button" class="example-chip" data-example="@example">@example</button>
        }
    </div>
</section>

@if (Model.Resultado is not null)
{
    <section class="result-card @(Model.Resultado.Valido ? "valid" : "invalid")" aria-live="polite">
        <div class="result-icon">@(Model.Resultado.Valido ? "✓" : "×")</div>
        <div class="result-summary">
            <p class="result-title">@Model.Resultado.Mensaje</p>
            <p class="result-meta"><span>@Model.Resultado.Tokens.Count tokens</span><span>@Model.Resultado.Simbolos.Count símbolos</span><span>@Model.Resultado.Errores.Count errores</span></p>
        </div>
    </section>

    <section class="route-card token-file-card">
        <div class="section-heading">
            <div><span class="eyebrow">Salida del analizador</span><h2>Archivo de tokens</h2></div>
            <span class="route-count">@Model.Resultado.Tokens.Count tokens</span>
        </div>
        @if (Model.Resultado.Tokens.Count > 0)
        {
            <div class="token-output-wrap">
                <table class="token-output-table">
                    <thead><tr><th>Línea</th><th>Tokens resultantes</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Resultado.Tokens.GroupBy(token => token.Linea).OrderBy(group => group.Key))
                    {
                        <tr>
                            <td>@line.Key</td>
                            <td>
                                @foreach (var token in line)
                                {
                                    <span class="token-code @(!token.Valido ? "token-code-error" : "")" title="@token.Lexema">@token.Codigo</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="inline-empty">No se encontraron tokens en el programa fuente.</p>
        }
        <div class="save-actions">
            @if (Model.Resultado.Valido)
            {
                <form method="post" asp-page-handler="DescargarPrograma">
                    <input type="hidden" name="Cadena" value="@Model.Cadena" data-source-copy />
                    <button type="submit" id="save-program" class="download-action" data-save-button>Guardar programa fuente (.txt)</button>
                </form>
                <form method="post" asp-page-handler="DescargarTokens">
                    <input type="hidden" name="Cadena" value="@Model.Cadena" data-source-copy />
                    <button type="submit" id="download-tokens" class="download-action" data-save-button>Guardar archivo de tokens (.txt)</button>
                </form>
                <small id="download-help">Verificación terminada: 0 errores. Ambos archivos están listos.</small>
            }
            else
            {
                <button type="button" id="save-program" class="download-action" data-save-button disabled>Guardar programa fuente (.txt)</button>
                <button type="button" id="download-tokens" class="download-action" data-save-button disabled>Guardar archivo de tokens (.txt)</button>
                <small id="download-help">Corrige todos los errores y vuelve a verificar para habilitar ambos archivos.</small>
            }
        </div>
    </section>

    @if (Model.ArchivoMensaje is not null)
    {
        <p class="file-warning" role="alert">@Model.ArchivoMensaje</p>
    }

    @if (Model.Resultado.Errores.Count > 0)
    {
        <section class="error-list" aria-label="Errores léxicos">
            <div class="section-heading">
                <div><span class="eyebrow error-eyebrow">Revisión necesaria</span><h2>Errores léxicos</h2></div>
                <span class="error-count">@Model.Resultado.Errores.Count errores</span>
            </div>
            @foreach (var error in Model.Resultado.Errores)
            {
                <article class="error-item"><code>@error.Lexema</code><div><strong>Línea @error.Linea, columna @error.Columna</strong><p>@error.Descripcion</p></div></article>
            }
        </section>
    }

    <section class="route-card">
        <div class="section-heading">
            <div><span class="eyebrow">Ejecución del AFND</span><h2>Tabla de recorrido</h2></div>
            <span class="route-count">@Model.Resultado.TotalPasos pasos</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Token</th><th>Lexema</th><th>Línea</th><th>Paso</th><th>Carácter</th><th>Tipo</th><th>Estado anterior</th><th>Estado nuevo</th></tr></thead>
                <tbody>
                @foreach (var token in Model.Resultado.Tokens)
                {
                    @foreach (var step in token.Pasos)
                    {
                        <tr class="@(step.EstadoNuevo == "q179" ? "error-row" : "")">
                            <td>@token.Numero</td><td><code>@token.Lexema</code></td><td>@token.Linea</td><td>@step.Paso</td>
                            <td><code>@step.Caracter</code></td><td>@step.Tipo</td><td><code>@step.EstadoAnterior</code></td><td><code>@step.EstadoNuevo</code></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="route-card symbol-card">
        <div class="section-heading">
            <div><span class="eyebrow">Identificadores únicos</span><h2>Tabla de símbolos</h2></div>
            <span class="route-count">@Model.Resultado.Simbolos.Count símbolos</span>
        </div>
        @if (Model.Resultado.Simbolos.Count > 0)
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>ID</th><th>Nombre</th><th>Tipo de dato</th><th>Valor</th><th>Línea de declaración</th></tr></thead>
                    <tbody>
                    @foreach (var symbol in Model.Resultado.Simbolos)
                    {
                        <tr><td><code>@symbol.Identificador</code></td><td><strong>@symbol.Nombre</strong></td><td>@symbol.TipoDato</td><td>@symbol.Valor</td><td>@symbol.LineaDeclaracion</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="inline-empty">No se detectaron identificadores. Las palabras reservadas y los operadores no se agregan a esta tabla.</p>
        }
    </section>
}
else
{
    <section class="empty-state">
        <div class="empty-orbit">q0</div>
        <div><h2>El análisis aparecerá aquí</h2><p>Verás el archivo de tokens, el recorrido de estados, los errores y la tabla de símbolos.</p></div>
    </section>
}
